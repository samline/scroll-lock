---
import './_shared.css'
import './_panels.css'

const panels = [
  { id: 'source', label: 'Source', row: 'Source line' },
  { id: 'preview', label: 'Preview', row: 'Preview paragraph' },
]
---

<div class="scroll-lock-example">
  <div class="controls" role="group" aria-label="Editor locks">
    {panels.map(panel => (
      <button
        type="button"
        class="pill"
        data-editor-lock
        aria-controls={`scroll-lock-editor-${panel.id}`}
        aria-pressed="false"
      >
        Lock {panel.label.toLowerCase()}
      </button>
    ))}
    <button type="button" class="pill" data-editor-lock aria-pressed="false">
      Lock page
    </button>
    <output aria-live="polite" data-page-status>Page scrolls</output>
  </div>
  <p class="hint">
    Lock Source, then scroll Preview and the page: only Source stays put. A filled button marks a
    held lock.
  </p>
  <div class="panel-grid">
    {panels.map(panel => (
      <div>
        <div class="sheet-header">
          <h3 class="part-title" id={`scroll-lock-editor-${panel.id}-title`}>{panel.label}</h3>
          <output class="tag" aria-live="polite" data-panel-status={panel.id}>scrolls</output>
        </div>
        <div
          id={`scroll-lock-editor-${panel.id}`}
          class="list panel-scroll"
          tabindex="0"
          role="region"
          aria-labelledby={`scroll-lock-editor-${panel.id}-title`}
        >
          {Array.from({ length: 16 }, (_, index) => (
            <p>
              {panel.row} {index + 1}
            </p>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { createScrollLock, isScrollLocked } from '@samline/scroll-lock'
  import { preview } from '../../shared/lib/preview'
  import { showPageState } from './_page-state'

  preview('editor', stage => {
    const state = showPageState(stage.querySelector('[data-page-status]')!)
    const locks = Array.from(
      stage.querySelectorAll<HTMLButtonElement>('[data-editor-lock]'),
      button => {
        const id = button.getAttribute('aria-controls')
        const target = id ? stage.querySelector<HTMLElement>(`#${id}`)! : undefined
        const lock = createScrollLock(target ? { target } : {})
        button.addEventListener('click', () => {
          lock.toggle()
          const held = isScrollLocked(target)
          button.setAttribute('aria-pressed', String(held))
          // Every panel keeps its own text status next to the filled button.
          const status = id && stage.querySelector<HTMLOutputElement>(`[data-panel-status="${id.replace('scroll-lock-editor-', '')}"]`)
          if (status) status.value = held ? 'locked' : 'scrolls'
          state.update()
        })
        return lock
      }
    )
    return [...locks, state.destroy]
  })
</script>

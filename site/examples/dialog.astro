---
import './_shared.css'
---

<div class="preview scroll-lock-example">
  <div class="controls">
    <button type="button" class="pill" data-open aria-haspopup="dialog">Read the terms</button>
    <output aria-live="polite">Page scrolls</output>
  </div>
  <p class="hint">Open it and try to scroll this page: it stays still, while the list inside scrolls.</p>
  <dialog
    class="sheet"
    data-preview="dialog"
    data-scroll-lock
    closedby="any"
    aria-labelledby="scroll-lock-terms-title"
  >
    <div class="sheet-header">
      <p class="part-title" id="scroll-lock-terms-title">Terms</p>
      <form method="dialog">
        <button class="close" aria-label="Close the terms">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </form>
    </div>
    <div class="list" tabindex="0" role="region" aria-label="Clauses">
      {Array.from({ length: 12 }, (_, i) => <p>Clause {i + 1}. This list scrolls; the page behind it does not.</p>)}
    </div>
    <p class="hint">Close it any way you like: the page scrolls again each time.</p>
    <form method="dialog" class="actions"><button class="pill">Accept</button></form>
  </dialog>
</div>

<script>
  import { scrollLock } from '@samline/scroll-lock'
  import { preview } from '../../shared/lib/preview'
  import { showPageState } from './_page-state'

  preview('dialog', stage => {
    const dialog = stage.querySelector<HTMLDialogElement>('[data-preview="dialog"]')!
    const opener = stage.querySelector<HTMLButtonElement>('[data-open]')!
    const state = showPageState(stage.querySelector('output')!)
    // The watcher follows the dialog's open attribute: every way of closing
    // it (button, form, Escape, click outside) releases the lock.
    const controller = scrollLock(dialog)
    const open = () => dialog.showModal()
    // Light dismiss where closedby="any" is not supported yet (Safari).
    const dismiss = (event: MouseEvent) => {
      if ('closedBy' in HTMLDialogElement.prototype || event.target !== dialog) return
      const box = dialog.getBoundingClientRect()
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom
      if (!inside) dialog.close()
    }
    opener.addEventListener('click', open)
    dialog.addEventListener('click', dismiss)
    return () => {
      opener.removeEventListener('click', open)
      dialog.removeEventListener('click', dismiss)
      dialog.close()
      controller.destroy()
      state.destroy()
    }
  })
</script>

---
import './_shared.css'
---

<div class="scroll-lock-example">
  <div class="controls">
    <button type="button" class="pill" data-open-animated aria-haspopup="dialog">
      Open account menu
    </button>
    <output aria-live="polite">Page scrolls</output>
  </div>
  <dialog class="sheet" aria-labelledby="scroll-lock-account-title">
    <h3 class="part-title" id="scroll-lock-account-title">
      Account menu
    </h3>
    <div class="actions">
      <button type="button" class="pill" autofocus>
        Close account menu
      </button>
    </div>
  </dialog>
</div>

<script>
  import { createScrollLock } from '@samline/scroll-lock'
  import { preview } from '../../shared/lib/preview'
  import { showPageState } from './_page-state'

  preview('animated', stage => {
    const menu = stage.querySelector('dialog')!
    const lock = createScrollLock()
    const state = showPageState(stage.querySelector('output')!)
    let exit: Animation | undefined

    stage.querySelector('[data-open-animated]')!.addEventListener('click', () => {
      if (exit || menu.open) return
      menu.showModal()
      lock.lock()
    })

    const close = async () => {
      if (exit || !menu.open) return
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        exit = menu.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, fill: 'forwards' })
        await Promise.allSettled([exit.finished])
      }
      menu.close()
      exit?.cancel()
      exit = undefined
      lock.unlock()
    }

    menu.addEventListener('cancel', event => {
      event.preventDefault()
      void close()
    })
    menu.querySelector('button')!.addEventListener('click', close)
    menu.addEventListener('close', () => {
      if (!menu.open) lock.unlock()
    })

    return () => {
      exit?.cancel()
      menu.close()
      lock.destroy()
      state.destroy()
    }
  })
</script>
